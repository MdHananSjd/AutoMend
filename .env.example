# AutoMend — Environment Configuration
# Copy to .env and fill in values.
# NEVER commit .env to version control.

# GCP Project
GCP_PROJECT_ID=automend-hackathon
GCP_REGION=us-central1

# Service URLs (override for local testing — defaults work when deployed to Cloud Run)
# DIAGNOSIS_AGENT_URL=https://automend-diagnosis-247530183292.us-central1.run.app/diagnose
# TARGET_SERVICE_URL=https://automend-target-247530183292.us-central1.run.app/health

# Cloud Run service name for the Target Service (used by Admin API calls)
TARGET_CLOUD_RUN_SERVICE=automend-target

# Timeouts
DIAGNOSIS_TIMEOUT_SECONDS=10
VERIFICATION_POLL_INTERVAL_SECONDS=5
VERIFICATION_WINDOW_SECONDS=60

# Diagnosis Agent — AI Studio API key (free tier, zero cost)
# Get yours from: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-ai-studio-api-key-here

# Firebase (for dashboard — these are public project identifiers, not secrets)
FIREBASE_API_KEY=AIzaSyARIULZpu714_Qw0IC72yPIz0Kg3eHEIbE
FIREBASE_AUTH_DOMAIN=automend-hackathon.firebaseapp.com
FIREBASE_PROJECT_ID=automend-hackathon
FIREBASE_STORAGE_BUCKET=automend-hackathon.appspot.com
FIREBASE_MESSAGING_SENDER_ID=247530183292
