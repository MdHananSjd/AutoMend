# AutoMend — Environment Configuration
# Copy to .env and fill in values.
# NEVER commit .env to version control.

# GCP Project
GCP_PROJECT_ID=automend-hackathon
GCP_REGION=us-central1

# Service URLs (fill in after deploying each service)
DIAGNOSIS_AGENT_URL=https://automend-diagnosis-XXXXX-uc.a.run.app
TARGET_SERVICE_URL=https://automend-target-XXXXX-uc.a.run.app

# Cloud Run service name for the Target Service (used by Admin API calls)
TARGET_CLOUD_RUN_SERVICE=automend-target

# Timeouts
DIAGNOSIS_TIMEOUT_SECONDS=10
VERIFICATION_POLL_INTERVAL_SECONDS=5
VERIFICATION_WINDOW_SECONDS=60

# Firebase (for dashboard — get from Firebase Console > Project Settings)
FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=automend-hackathon.firebaseapp.com
FIREBASE_PROJECT_ID=automend-hackathon
FIREBASE_STORAGE_BUCKET=automend-hackathon.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
